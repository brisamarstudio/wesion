# Wesion — le variabili, e chi le usa.
#
# Copiare in `.env` e riempire. Il `.env` NON entra nelle immagini (è in
# .dockerignore) e non va committato: le variabili le passa il compose a runtime.
#
# I valori del router esistono già nel .env di `mywebby-automations` su Oracle:
# si copiano da lì, non si rigenerano. Rigenerare un refresh token di Google
# quando quello buono c'è già vuol dire rompere il vecchio router mentre gira.

# ── Le usano tutti e due ────────────────────────────────────────────────────
DATABASE_URL=postgres://utente:password@host.eu-central-1.aws.neon.tech/wesion?sslmode=require
OCR_MODEL=google/gemini-2.5-flash

# La catena dei generatori, nell'ordine in cui viene provata. Le prime tre sono
# gratuite o a forfait: si scende solo quando quella sopra non risponde.
#   1. Groq        gratis, ~1,4s      la piu' veloce di tutte
#   2. Nara         gratis, ~8,5s      SOLO i modelli col suffisso -free; vuole
#                                      l'iscrizione a un canale Telegram
#   3. Z.AI (GLM)  piano a forfait    ~15s: ottima come rete, lenta come prima scelta
#   4. OpenRouter  a consumo          ultima spiaggia, e serve comunque per l'OCR dei menu
GROQ_API_KEY=
NARA_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=

# ── Solo la dashboard ───────────────────────────────────────────────────────
# Firma i cookie di sessione. Cambiarla fa uscire tutti, subito.
# Si genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
APIFY_API_TOKEN=
APIFY_ACTOR_ID=compass~crawler-google-places
# Su quale porta di 127.0.0.1 la trova nginx.
DASHBOARD_PORT=3020

# ── Solo il router ──────────────────────────────────────────────────────────
# L'indirizzo di ascolto È la difesa: 172.17.0.1 è l'interfaccia docker0,
# raggiungibile dai container sulla stessa macchina e mai da internet.
# Non metterci 0.0.0.0.
ROUTER_HOST=172.17.0.1
ROUTER_PORT=3010
# Senza questo, chiunque sulla stessa macchina può far pubblicare il router.
ROUTER_SECRET=

# Il container WAHA del numero bot condiviso (waha-weareqr-bot, porta 3006).
WAHA_BASE=http://127.0.0.1:3006
WAHA_API_KEY=
WAHA_SESSION=default

# Dove finisce la foto del menù per il post di Google: Google vuole una URL
# pubblica. È lo stesso upload.php condiviso da tutti i siti su Ergonet.
MEDIA_UPLOAD_URL=https://media.mywebby.it/upload.php
MEDIA_UPLOAD_TOKEN=

# Il refresh token è UNO d'agenzia e copre tutte le schede: sta solo qui, mai
# nei progetti Cloudflare dei singoli siti.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# A chi arriva l'avviso di lead caldo, separati da virgola.
NUMERI_AMMINISTRATORI=

# Facoltative: i valori qui sotto sono già i default.
DRAFT_TTL_MINUTES=15
MAX_ITEMS=12
SECONDI_GIRO=30
