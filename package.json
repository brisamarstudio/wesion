{
  "name": "wesion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wesion — la regia unica MyWebby: lead, menu del giorno, post Google.",
  "scripts": {
    "db:schema": "node --env-file=.env db/applica-schema.mjs",
    "db:migra": "node --env-file=.env db/migra-da-leadgen.mjs",
    "db:conta": "node --env-file=.env db/conta.mjs",
    "dev": "next dev --webpack -p 3015",
    "build": "next build",
    "start": "next start -p 3015",
    "astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs",
    "router": "node --experimental-strip-types --env-file=.env router/index.ts",
    "cliente": "node --experimental-strip-types --env-file=.env db/configura-cliente.ts",
    "utente": "node --experimental-strip-types --env-file=.env db/crea-utente.ts",
    "prova:seo": "node --experimental-strip-types db/prova-seo-proposta.ts"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.1.9",
    "@astryxdesign/core": "^0.1.9",
    "@astryxdesign/theme-neutral": "^0.1.9",
    "@stylexjs/stylex": "^0.19.0",
    "lucide-react": "^1.37.0",
    "next": "^16.2.10",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.9.3"
  }
}
